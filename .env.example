# Copy to .env and fill in. The .env is git-ignored.

# --- Telemetry source (the DataViewer the bridge subscribes to) ---
# Sim validation:
SIM_HOST=192.168.20.13
# On the boat instead use:  SIM_HOST=host.docker.internal
SIM_PORT=8085

# --- Local InfluxDB container (created on first `up`) ---
INFLUX_USERNAME=admin
INFLUX_PASSWORD=change-me-strong-password
INFLUX_ORG=metrics-org
INFLUX_BUCKET=B3-CIS-TEST
# Admin token for the container (used by the bridge writer and the detection fetcher).
# Generate one, e.g.:  openssl rand -hex 32
INFLUX_TOKEN=change-me-influx-admin-token
INFLUX_HOST_PORT=8087
BRIDGE_HOST_PORT=8002

# --- Shore InfluxDB (replicator egress) ---
# Test rig: a 2nd local container (shore-influxdb). On the boat: point SHORE_INFLUX_URL at the
# real shore Influx by HOSTNAME (so an IP change is transparent) and keep its token.
SHORE_INFLUX_URL=http://shore-influxdb:8086
SHORE_INFLUX_ORG=metrics-org
SHORE_INFLUX_BUCKET=B3-CIS-TEST
SHORE_INFLUX_PASSWORD=change-me-shore-password
SHORE_INFLUX_TOKEN=change-me-shore-token
SHORE_INFLUX_HOST_PORT=8088

# --- Boat / pipeline ---
ONBOARD_BOAT=B3
# Stamped into created_by/updated_by on DB writes (toolkit requires it)
USERNAME=firstname.familyname
DETECT_INTERVAL=20
DETECT_LOOKBACK=600
REPLICATOR_WINDOW_S=30

# --- Neon (POIs + analyses land here) ---
# Must end in _POSTGRES_URL so the toolkit auto-registers it as a DB alias.
AC75_ONBOARD_TEST_POSTGRES_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# --- Control panel ---
# Absolute host path of the project root (as the Docker DAEMON sees it), so the control
# panel can rebuild the stack. the repo root that holds docker-compose.yml + the sailing-data-toolkit submodule. WSL: /mnt/c/...
HOST_PROJECT_DIR=/path/to/perf-analysis-appliance
CONTROL_HOST_PORT=4267
